{
  "name": "tashkent-invest-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "bun bin/www",
    "dev": "bun --watch bin/www",
    "test": "NODE_ENV=test bun test --isolate",
    "test:coverage": "NODE_ENV=test bun test --isolate --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "db:migrate": "sequelize-cli db:migrate --config db/config.js --migrations-path db/migrations",
    "db:seed": "bun db/seed.js && bun db/sync-geographic-areas.js && bun db/sync-osm-footprints.js",
    "db:sync-areas": "bun db/sync-geographic-areas.js",
    "db:sync-osm-footprints": "bun db/sync-osm-footprints.js"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.5"
  }
}
