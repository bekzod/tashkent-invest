PORT=8080
DATABASE_URL=postgres://tashkent_invest:tashkent_invest@localhost:5432/tashkent_invest
DATABASE_SSL=false
JWT_SECRET=replace-me-for-local-development
FRONT_HOST_NAME=http://localhost:3000,https://tashkent-invest.vercel.app,https://toshkent-tuman-invest.uz,https://www.toshkent-tuman-invest.uz
# Telegram admin xabarnomalari uchun. TOKEN bo‘sh bo‘lsa xabarnomalar o‘chirilgan bo‘ladi.
TELEGRAM_BOT_TOKEN=
# Admin bog‘lash deep linki uchun botning @ belgisiz public username'i.
TELEGRAM_BOT_USERNAME=
# Telegram webhook so‘rovlarini tekshirish uchun uzun, tasodifiy maxfiy qiymat.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Telegram ichidagi kabinet tugmasi uchun yagona canonical frontend URL.
APP_PUBLIC_URL=http://localhost:3000
# Local development only. Omit this variable or set it to false in production.
INCLUDE_DEMO_DATA=true
